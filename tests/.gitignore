# tests/ KAT suite -- local ignore rules (scope: this directory only).
#
# Patterns here are evaluated relative to tests/ (git applies a .gitignore's
# rules relative to the directory that contains it). This file deliberately
# does NOT add or modify any root-level .gitignore: per the AAP (section
# 0.1.1) "no top-level .gitignore modification is required", and the test
# suite is confined entirely to tests/.

# --- Generated build artifacts (never checked in) ------------------------
# tests/Makefile creates build/ via `mkdir -p` and populates it with the
# FASM-assembled shim object, the static archive, the optional shared
# object, and one statically linked harness binary per primitive:
#   build/shim.o
#   build/libht.a
#   build/libht.so      (optional; only when explicitly produced)
#   build/bin/kat_*      (one self-contained binary per primitive)
# `make clean` removes build/ in full; none of it belongs in version control.
build/

# --- Python / pytest caches (generated by the runner/ package) -----------
# The tests/runner/ pytest modules and tests/conftest.py produce bytecode
# caches and a pytest cache directory at collection/run time.
__pycache__/
*.py[cod]
.pytest_cache/

# --- Stray build outputs (defensive; normally confined to build/) --------
# Guard against object files, static archives, or shared objects that might
# ever be emitted outside build/ (e.g. ad-hoc manual assembly/compilation).
*.o
*.a
*.so
